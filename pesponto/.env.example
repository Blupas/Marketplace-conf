# Copie para .env e ajuste. Nunca versione o arquivo .env.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# OBRIGATÓRIO em produção: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=
SITE_NAME=Pesponto
CONTACT_EMAIL=contato@seudominio.com.br
# Atrás de proxy reverso (Nginx, Render, Railway, Fly...): TRUST_PROXY=1
TRUST_PROXY=0
# Persistência (em produção aponte para um volume/disco persistente)
DATA_DIR=data
# DB_PATH=data/pesponto.db
# UPLOAD_DIR=data/uploads
# Primeiro administrador (criado no primeiro boot se definido, ou via `npm run create-admin`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# E-mail (recuperação de senha e aviso de orçamento). Sem SMTP, o texto vai para o log do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pesponto <nao-responda@seudominio.com.br>
# Mapa/geocodificação (padrão: OpenStreetMap). Para alto volume use provedor próprio.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Planos pagos (reservado; mantenha 0 no lançamento)
BILLING_ENABLED=0
