<%
  const _site = locals.site.name;
  const _title = locals.title ? (locals.home ? locals.title : `${locals.title} · ${_site}`) : `${_site} — ${locals.site.tagline}`;
  const _desc = locals.description || locals.site.hero_subtitle || '';
  const _canon = locals.canonical ? (config.baseUrl + locals.canonical) : null;
  const _og = locals.ogImage ? (/^https?:/.test(locals.ogImage) ? locals.ogImage : config.baseUrl + locals.ogImage) : config.baseUrl + '/img/og-default.png';
%><!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= _title %></title>
  <meta name="description" content="<%= String(_desc).slice(0, 170) %>">
  <% if (locals.noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <% if (_canon) { %><link rel="canonical" href="<%= _canon %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:site_name" content="<%= _site %>">
  <meta property="og:title" content="<%= locals.title || _site %>">
  <meta property="og:description" content="<%= String(_desc).slice(0, 200) %>">
  <meta property="og:image" content="<%= _og %>">
  <% if (_canon) { %><meta property="og:url" content="<%= _canon %>"><% } %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#14264A">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/bricolage.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/instrument.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/app.css?v=<%= assetV %>">
  <% if (locals.needsMap) { %><link rel="stylesheet" href="/vendor/leaflet/leaflet.css"><link rel="stylesheet" href="/vendor/leaflet/MarkerCluster.css"><link rel="stylesheet" href="/vendor/leaflet/MarkerCluster.Default.css"><% } %>
  <% if (locals.jsonld) { %><script type="application/ld+json"><%- JSON.stringify(locals.jsonld).replace(/</g, '\\u003c') %></script><% } %>
</head>
<body class="<%= locals.bodyClass %>">
<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
<%- include('icons') %>
<%- include('header') %>
<main id="conteudo" tabindex="-1">
